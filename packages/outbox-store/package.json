{
    "name": "@event-driven-platform/outbox-store",
    "version": "0.0.1",
    "description": "Persistence port for atomically appending transactional Outbox records.",
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist/**/*.js",
        "dist/**/*.js.map",
        "dist/**/*.d.ts",
        "dist/**/*.d.ts.map"
    ],
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/sanshan/event-driven-platform.git",
        "directory": "packages/outbox-store"
    },
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "@event-driven-platform/outbox": "workspace:*",
        "tslib": "^2.3.0"
    },
    "devDependencies": {
        "@event-driven-platform/event": "workspace:*",
        "@event-driven-platform/types": "workspace:*"
    }
}
