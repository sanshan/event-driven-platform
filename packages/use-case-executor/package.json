{
    "name": "@event-driven-platform/use-case-executor",
    "version": "0.0.4",
    "description": "Durable UseCase invocation executor for the event-driven platform.",
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist/**/*.js",
        "dist/**/*.js.map",
        "dist/**/*.d.ts",
        "dist/**/*.d.ts.map"
    ],
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/sanshan/event-driven-platform.git",
        "directory": "packages/use-case-executor"
    },
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "@event-driven-platform/clock": "workspace:*",
        "@event-driven-platform/execution": "workspace:*",
        "@event-driven-platform/observability": "workspace:*",
        "@event-driven-platform/use-case": "workspace:*",
        "@event-driven-platform/use-case-execution-store": "workspace:*",
        "tslib": "catalog:"
    },
    "devDependencies": {
        "@event-driven-platform/command": "workspace:*",
        "@event-driven-platform/event": "workspace:*",
        "@event-driven-platform/intent": "workspace:*",
        "@event-driven-platform/operation": "workspace:*",
        "@event-driven-platform/operation-event-envelope-factory": "workspace:*",
        "@event-driven-platform/query": "workspace:*"
    }
}
