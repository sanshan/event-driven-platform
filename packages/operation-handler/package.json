{
    "name": "@event-driven-platform/operation-handler",
    "version": "0.0.9",
    "description": "Operation handler contract for executing one domain Operation within the Runner pipeline.",
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist/**/*.js",
        "dist/**/*.js.map",
        "dist/**/*.d.ts",
        "dist/**/*.d.ts.map"
    ],
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/sanshan/event-driven-platform.git",
        "directory": "packages/operation-handler"
    },
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "@event-driven-platform/operation": "workspace:*",
        "tslib": "catalog:"
    }
}
