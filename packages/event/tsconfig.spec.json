{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "outDir": "./out-tsc/vitest",
        "types": ["vitest/globals", "vitest/importMeta", "vite/client", "node", "vitest"],
        "importHelpers": true,
        "noImplicitReturns": true
    },
    "include": [
        "vite.config.ts",
        "vite.config.mts",
        "vitest.config.ts",
        "vitest.config.mts",
        "src/**/*.ts",
        "src/**/*.tsx",
        "src/**/*.js",
        "src/**/*.jsx",
        "src/**/*.d.ts"
    ],
    "references": [
        {
            "path": "./tsconfig.lib.json"
        }
    ]
}
