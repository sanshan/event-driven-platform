{
    "name": "@event-driven-platform/event",
    "version": "0.1.0",
    "description": "Versioned domain event contracts and identifiers for the event-driven platform.",
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist/**/*.js",
        "dist/**/*.js.map",
        "dist/**/*.d.ts",
        "dist/**/*.d.ts.map"
    ],
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/sanshan/event-driven-platform.git",
        "directory": "packages/event"
    },
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "@event-driven-platform/aggregate-reference": "workspace:*",
        "@event-driven-platform/tenant-reference": "workspace:*",
        "@event-driven-platform/types": "workspace:*",
        "tslib": "catalog:",
        "uuid": "catalog:",
        "zod": "catalog:"
    }
}
