{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "rootDir": "src",
        "outDir": "dist",
        "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
        "emitDeclarationOnly": false,
        "importHelpers": true,
        "noImplicitReturns": true,
        "types": ["node"]
    },
    "include": ["src/**/*.ts"],
    "references": [
        {
            "path": "../execution/tsconfig.lib.json"
        },
        {
            "path": "../read-handler-resolver/tsconfig.lib.json"
        },
        {
            "path": "../read-execution-coordinator/tsconfig.lib.json"
        },
        {
            "path": "../read/tsconfig.lib.json"
        },
        {
            "path": "../query/tsconfig.lib.json"
        },
        {
            "path": "../observability/tsconfig.lib.json"
        },
        {
            "path": "../clock/tsconfig.lib.json"
        },
        {
            "path": "../read-execution-coordinator-redis/tsconfig.lib.json"
        },
        {
            "path": "../read-cache-redis/tsconfig.lib.json"
        },
        {
            "path": "../read-cache-in-memory/tsconfig.lib.json"
        }
    ],
    "exclude": [
        "vite.config.ts",
        "vite.config.mts",
        "vitest.config.ts",
        "vitest.config.mts",
        "src/**/*.test.ts",
        "src/**/*.spec.ts",
        "src/**/*.test.tsx",
        "src/**/*.spec.tsx",
        "src/**/*.test.js",
        "src/**/*.spec.js",
        "src/**/*.test.jsx",
        "src/**/*.spec.jsx"
    ]
}
