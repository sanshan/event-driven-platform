{
    "name": "@event-driven-platform/event-schema-protobuf",
    "version": "0.0.1",
    "description": "Render EDP runtime EventContract payloads as Protocol Buffers schema source.",
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": ["dist/**/*.js", "dist/**/*.js.map", "dist/**/*.d.ts", "dist/**/*.d.ts.map"],
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "license": "Apache-2.0",
    "publishConfig": { "access": "public" },
    "dependencies": {
        "@event-driven-platform/event": "workspace:*",
        "tslib": "catalog:",
        "zod": "catalog:"
    }
}
