{
    "name": "@event-driven-platform/outbox",
    "version": "0.0.9",
    "description": "Transactional Outbox record contracts and factories for event-driven platform execution.",
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist/**/*.js",
        "dist/**/*.js.map",
        "dist/**/*.d.ts",
        "dist/**/*.d.ts.map"
    ],
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/sanshan/event-driven-platform.git",
        "directory": "packages/outbox"
    },
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "@event-driven-platform/clock": "workspace:*",
        "@event-driven-platform/event": "workspace:*",
        "tslib": "catalog:"
    },
    "devDependencies": {
        "@event-driven-platform/aggregate-reference": "workspace:*",
        "@event-driven-platform/tenant-reference": "workspace:*",
        "@event-driven-platform/types": "workspace:*"
    }
}
