{
    "name": "@event-driven-platform/guard",
    "version": "0.0.3",
    "description": "Declarative execution guard policy contracts for event-driven platform Commands.",
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist/**/*.js",
        "dist/**/*.js.map",
        "dist/**/*.d.ts",
        "dist/**/*.d.ts.map"
    ],
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/sanshan/event-driven-platform.git",
        "directory": "packages/guard"
    },
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "tslib": "^2.3.0"
    }
}
