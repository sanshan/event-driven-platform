{
  "name": "@event-driven-platform/intent",
  "version": "0.2.0",
  "description": "Deterministic operation intent contracts and factory for the event-driven platform.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sanshan/event-driven-platform.git",
    "directory": "packages/intent"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@event-driven-platform/tenant-reference": "workspace:*",
    "tslib": "catalog:",
    "uuid": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@event-driven-platform/types": "workspace:*"
  }
}
